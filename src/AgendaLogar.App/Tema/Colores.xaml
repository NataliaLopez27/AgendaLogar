<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta tomada del logo de Logar Asesores -->
    <Color x:Key="ColorTurquesa">#1BA3BC</Color>
    <Color x:Key="ColorTurquesaOscuro">#0E6577</Color>
    <Color x:Key="ColorTurquesaClaro">#E3F4F7</Color>
    <Color x:Key="ColorNegro">#151515</Color>
    <Color x:Key="ColorGris">#8C8C8C</Color>
    <Color x:Key="ColorGrisLinea">#E3E6E8</Color>
    <Color x:Key="ColorFondo">#F6F8F9</Color>
    <Color x:Key="ColorBlanco">#FFFFFF</Color>
    <Color x:Key="ColorError">#C0392B</Color>
    <Color x:Key="ColorErrorFondo">#FCEDEB</Color>
    <Color x:Key="ColorExito">#1E8E5A</Color>

    <SolidColorBrush x:Key="Turquesa" Color="{StaticResource ColorTurquesa}" />
    <SolidColorBrush x:Key="TurquesaOscuro" Color="{StaticResource ColorTurquesaOscuro}" />
    <SolidColorBrush x:Key="TurquesaClaro" Color="{StaticResource ColorTurquesaClaro}" />
    <SolidColorBrush x:Key="Negro" Color="{StaticResource ColorNegro}" />
    <SolidColorBrush x:Key="Gris" Color="{StaticResource ColorGris}" />
    <SolidColorBrush x:Key="GrisLinea" Color="{StaticResource ColorGrisLinea}" />
    <SolidColorBrush x:Key="Fondo" Color="{StaticResource ColorFondo}" />
    <SolidColorBrush x:Key="Blanco" Color="{StaticResource ColorBlanco}" />
    <SolidColorBrush x:Key="Error" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="ErrorFondo" Color="{StaticResource ColorErrorFondo}" />
    <SolidColorBrush x:Key="Exito" Color="{StaticResource ColorExito}" />

    <FontFamily x:Key="FuenteTexto">Segoe UI</FontFamily>
    <FontFamily x:Key="FuenteTitulo">Bodoni MT, Didot, Georgia</FontFamily>
    <FontFamily x:Key="FuenteFirma">Segoe Script, Brush Script MT</FontFamily>
</ResourceDictionary>
