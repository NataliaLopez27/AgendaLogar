<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Textos -->
    <Style x:Key="TituloPagina" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteTitulo}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource Negro}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Subtitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Gris}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TurquesaOscuro}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <!-- Tarjeta -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Blanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource GrisLinea}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{StaticResource Sombra}" />
    </Style>

    <!-- Mensaje de error / aviso -->
    <Style x:Key="CajaError" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErrorFondo}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <!-- Cajas de texto -->
    <Style x:Key="EntradaBase" TargetType="Control">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Foreground" Value="{StaticResource Negro}" />
        <Setter Property="Background" Value="{StaticResource Blanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource GrisLinea}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource EntradaBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Turquesa}" />
                            <Setter TargetName="Borde" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Fondo}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource EntradaBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Turquesa}" />
                            <Setter TargetName="Borde" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Negro}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Botones -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Turquesa}" />
        <Setter Property="Foreground" Value="{StaticResource Blanco}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource TurquesaOscuro}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="Background" Value="{StaticResource Blanco}" />
        <Setter Property="Foreground" Value="{StaticResource TurquesaOscuro}" />
        <Setter Property="BorderBrush" Value="{StaticResource Turquesa}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource TurquesaClaro}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón blanco para usar sobre la cabecera turquesa -->
    <Style x:Key="BotonClaro" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="Background" Value="{StaticResource Blanco}" />
        <Setter Property="Foreground" Value="{StaticResource TurquesaOscuro}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource TurquesaClaro}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
        <Setter Property="Foreground" Value="{StaticResource Error}" />
        <Setter Property="BorderBrush" Value="{StaticResource Error}" />
    </Style>

    <Style x:Key="BotonEnlace" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Gris}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Texto" Text="{TemplateBinding Content}" Padding="0,4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource Turquesa}" />
                            <Setter TargetName="Texto" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opción del menú lateral (fondo turquesa oscuro). El icono va en Tag. -->
    <Style x:Key="OpcionMenu" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#D9FFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="8">
                        <Grid>
                            <Border x:Name="Marca" Width="4" HorizontalAlignment="Left" CornerRadius="2"
                                    Margin="0,8" Background="{StaticResource Blanco}" Visibility="Hidden" />
                            <StackPanel Orientation="Horizontal" Margin="16,11,12,11">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource FuenteIconos}"
                                           FontSize="16" Width="22" VerticalAlignment="Center" />
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource Blanco}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#2EFFFFFF" />
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Blanco}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enlaces del menú lateral (cambiar contraseña, cerrar sesión) -->
    <Style x:Key="EnlaceMenu" TargetType="Button">
        <Setter Property="Foreground" Value="#BFFFFFFF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="6" Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource FuenteIconos}"
                                       FontSize="14" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Content}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource Blanco}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tarjeta de acceso rápido del inicio. Icono en Tag; título y texto en el contenido. -->
    <Style x:Key="TarjetaAcceso" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="250" />
        <Setter Property="Margin" Value="0,0,18,18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{StaticResource Blanco}" CornerRadius="12" Padding="20"
                            BorderBrush="{StaticResource GrisLinea}" BorderThickness="1" Effect="{StaticResource Sombra}">
                        <StackPanel>
                            <Border x:Name="Circulo" Width="46" Height="46" CornerRadius="23" HorizontalAlignment="Left"
                                    Background="{StaticResource TurquesaClaro}">
                                <TextBlock x:Name="Icono" Text="{TemplateBinding Tag}" FontFamily="{StaticResource FuenteIconos}"
                                           FontSize="20" Foreground="{StaticResource TurquesaOscuro}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Turquesa}" />
                            <Setter TargetName="Circulo" Property="Background" Value="{StaticResource Turquesa}" />
                            <Setter TargetName="Icono" Property="Foreground" Value="{StaticResource Blanco}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tablas -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Blanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource GrisLinea}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{StaticResource Blanco}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Fondo}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GrisLinea}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Blanco}" />
        <Setter Property="Foreground" Value="{StaticResource TurquesaOscuro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,10" />
        <Setter Property="BorderBrush" Value="{StaticResource Turquesa}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource TurquesaClaro}" />
                <Setter Property="Foreground" Value="{StaticResource Negro}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Etiqueta redondeada (rol, estado) -->
    <Style x:Key="Pastilla" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource TurquesaClaro}" />
    </Style>
</ResourceDictionary>
