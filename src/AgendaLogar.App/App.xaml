<Application x:Class="AgendaLogar.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgendaLogar.Presentacion.ViewModels;assembly=AgendaLogar.Presentacion"
             xmlns:v="clr-namespace:AgendaLogar.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Cada ViewModel se pinta con su vista: así funciona la navegación. -->
        <DataTemplate DataType="{x:Type vm:InicioViewModel}">
            <v:InicioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CatalogoModelosViewModel}">
            <v:CatalogoModelosView />
        </DataTemplate>

        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Application.Resources>
</Application>
