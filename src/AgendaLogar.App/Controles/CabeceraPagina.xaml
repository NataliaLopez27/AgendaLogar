<UserControl x:Class="AgendaLogar.App.Controles.CabeceraPagina"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz">
    <!-- Banda de título con degradado turquesa y las rayas del logo a la derecha -->
    <Border CornerRadius="14" Background="{StaticResource DegradadoCabecera}" Effect="{StaticResource Sombra}" ClipToBounds="True">
        <Grid>
            <!-- Rayas decorativas en la esquina derecha -->
            <Border HorizontalAlignment="Right" Width="260" Background="{StaticResource RayasBlancas}" CornerRadius="0,14,14,0">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="Black" Offset="1" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>

            <DockPanel Margin="28,22">
                <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="26" Background="#33FFFFFF"
                        VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="{Binding Icono, ElementName=Raiz}" FontFamily="{StaticResource FuenteIconos}" FontSize="22"
                               Foreground="{StaticResource Blanco}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center"
                                  Content="{Binding Acciones, ElementName=Raiz}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Titulo, ElementName=Raiz}" FontFamily="{StaticResource FuenteTitulo}"
                               FontSize="28" Foreground="{StaticResource Blanco}" />
                    <TextBlock Text="{Binding Subtitulo, ElementName=Raiz}" FontSize="14" Foreground="#E6FFFFFF"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
