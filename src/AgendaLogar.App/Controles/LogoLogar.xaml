<UserControl x:Class="AgendaLogar.App.Controles.LogoLogar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Si existe Recursos/logo.png se muestra la imagen original;
         si no, esta versión dibujada en vectores. -->
    <Grid>
    <Image x:Name="ImagenLogo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
    <Viewbox x:Name="LogoVectorial" Stretch="Uniform">
        <Canvas Width="460" Height="610">
            <!-- Rayas diagonales turquesa (esquina superior izquierda) -->
            <Canvas>
                <Canvas.Clip>
                    <PathGeometry Figures="M0,0 L215,0 L0,300 Z" />
                </Canvas.Clip>
                <Canvas.Resources>
                    <Style TargetType="Line">
                        <Setter Property="Stroke" Value="{StaticResource Turquesa}" />
                        <Setter Property="StrokeThickness" Value="11" />
                        <Setter Property="StrokeStartLineCap" Value="Round" />
                        <Setter Property="StrokeEndLineCap" Value="Round" />
                    </Style>
                </Canvas.Resources>
                <Line X1="-330" Y1="-10" X2="-10" Y2="310" />
                <Line X1="-290" Y1="-10" X2="30" Y2="310" />
                <Line X1="-250" Y1="-10" X2="70" Y2="310" />
                <Line X1="-210" Y1="-10" X2="110" Y2="310" />
                <Line X1="-170" Y1="-10" X2="150" Y2="310" />
                <Line X1="-130" Y1="-10" X2="190" Y2="310" />
                <Line X1="-90" Y1="-10" X2="230" Y2="310" />
                <Line X1="-50" Y1="-10" X2="270" Y2="310" />
                <Line X1="-10" Y1="-10" X2="310" Y2="310" />
                <Line X1="30" Y1="-10" X2="350" Y2="310" />
                <Line X1="70" Y1="-10" X2="390" Y2="310" />
                <Line X1="110" Y1="-10" X2="430" Y2="310" />
                <Line X1="150" Y1="-10" X2="470" Y2="310" />
                <Line X1="190" Y1="-10" X2="510" Y2="310" />
            </Canvas>

            <!-- Monograma LG -->
            <TextBlock Canvas.Left="120" Canvas.Top="60" Text="L" FontSize="210"
                       FontFamily="{StaticResource FuenteFirma}" Foreground="{StaticResource Negro}" />
            <TextBlock Canvas.Left="215" Canvas.Top="150" Text="G" FontSize="210"
                       FontFamily="{StaticResource FuenteFirma}" Foreground="{StaticResource Turquesa}" />

            <!-- Línea gris -->
            <Rectangle Canvas.Left="40" Canvas.Top="428" Width="392" Height="8" Fill="{StaticResource Gris}" />

            <!-- LOGAR ASESORES, con las "O" en turquesa -->
            <StackPanel Canvas.Left="0" Canvas.Top="448" Width="460">
                <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource FuenteTitulo}" FontSize="68"
                           Foreground="{StaticResource Negro}">
                    <Run Text="L" /><Run Text="O" Foreground="{StaticResource Turquesa}" /><Run Text="GAR" />
                </TextBlock>
                <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource FuenteTitulo}" FontSize="68"
                           Foreground="{StaticResource Negro}" Margin="0,-10,0,0">
                    <Run Text="ASES" /><Run Text="O" Foreground="{StaticResource Turquesa}" /><Run Text="RES" />
                </TextBlock>
            </StackPanel>
        </Canvas>
    </Viewbox>
    </Grid>
</UserControl>
