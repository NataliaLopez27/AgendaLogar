<UserControl x:Class="AgendaLogar.App.Controles.LogoMonograma"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Versión reducida del logo (monograma LG) para el menú lateral. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="140" Height="140">
            <Canvas>
                <Canvas.Clip>
                    <PathGeometry Figures="M0,0 L80,0 L0,110 Z" />
                </Canvas.Clip>
                <Canvas.Resources>
                    <Style TargetType="Line">
                        <Setter Property="Stroke" Value="{StaticResource Turquesa}" />
                        <Setter Property="StrokeThickness" Value="6" />
                        <Setter Property="StrokeStartLineCap" Value="Round" />
                        <Setter Property="StrokeEndLineCap" Value="Round" />
                    </Style>
                </Canvas.Resources>
                <Line X1="-150" Y1="-5" X2="0" Y2="145" />
                <Line X1="-128" Y1="-5" X2="22" Y2="145" />
                <Line X1="-106" Y1="-5" X2="44" Y2="145" />
                <Line X1="-84" Y1="-5" X2="66" Y2="145" />
                <Line X1="-62" Y1="-5" X2="88" Y2="145" />
                <Line X1="-40" Y1="-5" X2="110" Y2="145" />
                <Line X1="-18" Y1="-5" X2="132" Y2="145" />
                <Line X1="4" Y1="-5" X2="154" Y2="145" />
                <Line X1="26" Y1="-5" X2="176" Y2="145" />
                <Line X1="48" Y1="-5" X2="198" Y2="145" />
                <Line X1="70" Y1="-5" X2="220" Y2="145" />
                <Line X1="92" Y1="-5" X2="242" Y2="145" />
            </Canvas>
            <TextBlock Canvas.Left="22" Canvas.Top="-6" Text="L" FontSize="100"
                       FontFamily="{StaticResource FuenteFirma}" Foreground="{StaticResource Negro}" />
            <TextBlock Canvas.Left="62" Canvas.Top="30" Text="G" FontSize="100"
                       FontFamily="{StaticResource FuenteFirma}" Foreground="{StaticResource Turquesa}" />
        </Canvas>
    </Viewbox>
</UserControl>
