<UserControl x:Class="AgendaLogar.App.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AgendaLogar.Presentacion.ViewModels;assembly=AgendaLogar.Presentacion"
             xmlns:c="clr-namespace:AgendaLogar.App.Controles"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance Type=vm:InicioViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30">
            <c:CabeceraPagina Titulo="{Binding Saludo}" Subtitulo="{Binding Fecha}" Icono="&#xE80F;">
                <c:CabeceraPagina.Acciones>
                    <Border Background="#33FFFFFF" CornerRadius="14" Padding="14,6">
                        <TextBlock Text="{Binding Rol}" Foreground="{StaticResource Blanco}" FontWeight="SemiBold" />
                    </Border>
                </c:CabeceraPagina.Acciones>
            </c:CabeceraPagina>

            <TextBlock Text="Accesos rápidos" FontFamily="{StaticResource FuenteTitulo}" FontSize="22"
                       Foreground="{StaticResource Negro}" Margin="0,30,0,16" />

            <WrapPanel>
                <!-- Mis asignaciones: llega en el hito 4 -->
                <Button Style="{StaticResource TarjetaAcceso}" Tag="&#xE787;" IsEnabled="False">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource TurquesaClaro}" CornerRadius="8" Padding="8,2">
                                <TextBlock Text="Próximamente" FontSize="11" Foreground="{StaticResource TurquesaOscuro}" />
                            </Border>
                            <TextBlock Text="Mis asignaciones" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Negro}" />
                        </DockPanel>
                        <TextBlock Text="Tus clientes del trimestre, separados en personas físicas y sociedades."
                                   Style="{StaticResource Subtitulo}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TarjetaAcceso}" Tag="&#xE72E;" Command="{Binding IrACambiarPasswordCommand}">
                    <StackPanel>
                        <TextBlock Text="Cambiar contraseña" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Negro}" />
                        <TextBlock Text="Actualiza tu contraseña de acceso." Style="{StaticResource Subtitulo}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TarjetaAcceso}" Tag="&#xE787;" Command="{Binding IrAPeriodosCommand}"
                        Visibility="{Binding EsAdmin, Converter={StaticResource BoolAVisibilidad}}">
                    <StackPanel>
                        <TextBlock Text="Periodos" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Negro}" />
                        <TextBlock Text="Crea trimestres y años, reparte los clientes y ciérralos." Style="{StaticResource Subtitulo}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TarjetaAcceso}" Tag="&#xE77B;" Command="{Binding IrAClientesCommand}"
                        Visibility="{Binding EsAdmin, Converter={StaticResource BoolAVisibilidad}}">
                    <StackPanel>
                        <TextBlock Text="Clientes" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Negro}" />
                        <TextBlock Text="Altas, datos, modelos y bajas de clientes." Style="{StaticResource Subtitulo}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TarjetaAcceso}" Tag="&#xE716;" Command="{Binding IrAEmpleadosCommand}"
                        Visibility="{Binding EsAdmin, Converter={StaticResource BoolAVisibilidad}}">
                    <StackPanel>
                        <TextBlock Text="Empleados" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Negro}" />
                        <TextBlock Text="Altas, roles, desactivaciones y contraseñas." Style="{StaticResource Subtitulo}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TarjetaAcceso}" Tag="&#xE8A5;" Command="{Binding IrACatalogoModelosCommand}"
                        Visibility="{Binding EsAdmin, Converter={StaticResource BoolAVisibilidad}}">
                    <StackPanel>
                        <TextBlock Text="Modelos fiscales" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Negro}" />
                        <TextBlock Text="Catálogo de modelos trimestrales y anuales." Style="{StaticResource Subtitulo}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
