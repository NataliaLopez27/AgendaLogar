<Window x:Class="AgendaLogar.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AgendaLogar.Presentacion.ViewModels;assembly=AgendaLogar.Presentacion"
        xmlns:c="clr-namespace:AgendaLogar.App.Controles"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Titulo}"
        Width="1280" Height="800" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fondo}"
        FontFamily="{StaticResource FuenteTexto}">
    <DockPanel>
        <!-- Menú lateral (solo con sesión iniciada) -->
        <Border DockPanel.Dock="Left" Width="264" Background="{StaticResource DegradadoMenu}"
                Visibility="{Binding MostrarMenu, Converter={StaticResource BoolAVisibilidad}}">
            <Grid>
                <!-- Rayas del logo, muy suaves, en la parte baja -->
                <Border VerticalAlignment="Bottom" Height="220" Background="{StaticResource RayasBlancas}" Opacity="0.35"
                        IsHitTestVisible="False">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="Black" Offset="1" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <DockPanel Margin="18,20">
                    <!-- Logo sobre tarjeta blanca -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource Blanco}" CornerRadius="12" Padding="14,10"
                            Margin="0,0,0,26" Height="150" Effect="{StaticResource Sombra}">
                        <c:LogoLogar />
                    </Border>

                    <!-- Usuario conectado y acciones de sesión -->
                    <Border DockPanel.Dock="Bottom" Background="#1F000000" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource Blanco}">
                                    <TextBlock Text="{Binding Iniciales}" Foreground="{StaticResource TurquesaOscuro}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NombreUsuario}" FontWeight="SemiBold" Foreground="{StaticResource Blanco}" />
                                    <TextBlock Text="{Binding RolUsuario}" FontSize="12" Foreground="#B3FFFFFF" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Cambiar contraseña" Tag="&#xE72E;" Command="{Binding IrACambiarPasswordCommand}"
                                    Style="{StaticResource EnlaceMenu}" />
                            <Button Content="Cerrar sesión" Tag="&#xE7E8;" Command="{Binding CerrarSesionCommand}"
                                    Style="{StaticResource EnlaceMenu}" />
                        </StackPanel>
                    </Border>

                    <!-- Opciones -->
                    <StackPanel>
                        <TextBlock Text="MI TRABAJO" FontSize="11" FontWeight="SemiBold" Foreground="#8CFFFFFF" Margin="16,0,0,8" />
                        <RadioButton Content="Inicio" Tag="&#xE80F;" Style="{StaticResource OpcionMenu}" GroupName="Menu"
                                     Command="{Binding IrAInicioCommand}"
                                     IsChecked="{Binding SeccionActual, Mode=OneWay, Converter={StaticResource IgualA}, ConverterParameter=InicioViewModel}" />

                        <StackPanel Visibility="{Binding EsAdmin, Converter={StaticResource BoolAVisibilidad}}">
                            <TextBlock Text="ADMINISTRACIÓN" FontSize="11" FontWeight="SemiBold" Foreground="#8CFFFFFF" Margin="16,22,0,8" />
                            <RadioButton Content="Periodos" Tag="&#xE787;" Style="{StaticResource OpcionMenu}" GroupName="Menu"
                                         Command="{Binding IrAPeriodosCommand}"
                                         IsChecked="{Binding SeccionActual, Mode=OneWay, Converter={StaticResource IgualA}, ConverterParameter=PeriodosViewModel}" />
                            <RadioButton Content="Clientes" Tag="&#xE77B;" Style="{StaticResource OpcionMenu}" GroupName="Menu"
                                         Command="{Binding IrAClientesCommand}"
                                         IsChecked="{Binding SeccionActual, Mode=OneWay, Converter={StaticResource IgualA}, ConverterParameter=ClientesViewModel}" />
                            <RadioButton Content="Empleados" Tag="&#xE716;" Style="{StaticResource OpcionMenu}" GroupName="Menu"
                                         Command="{Binding IrAEmpleadosCommand}"
                                         IsChecked="{Binding SeccionActual, Mode=OneWay, Converter={StaticResource IgualA}, ConverterParameter=EmpleadosViewModel}" />
                            <RadioButton Content="Modelos fiscales" Tag="&#xE8A5;" Style="{StaticResource OpcionMenu}" GroupName="Menu"
                                         Command="{Binding IrACatalogoModelosCommand}"
                                         IsChecked="{Binding SeccionActual, Mode=OneWay, Converter={StaticResource IgualA}, ConverterParameter=CatalogoModelosViewModel}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Vista actual (se elige por DataTemplate en App.xaml) -->
        <ContentControl Content="{Binding VistaActual}" Focusable="False" />
    </DockPanel>
</Window>
