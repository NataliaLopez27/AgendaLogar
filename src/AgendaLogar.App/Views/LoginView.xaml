<UserControl x:Class="AgendaLogar.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AgendaLogar.Presentacion.ViewModels;assembly=AgendaLogar.Presentacion"
             xmlns:c="clr-namespace:AgendaLogar.App.Controles"
             xmlns:ayuda="clr-namespace:AgendaLogar.App.Comportamientos"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Izquierda: logo sobre blanco -->
        <Border Grid.Column="0" Background="{StaticResource Blanco}">
            <c:LogoLogar Margin="60" MaxHeight="520" />
        </Border>

        <!-- Derecha: formulario -->
        <Border Grid.Column="1" Background="{StaticResource Fondo}">
            <Border Style="{StaticResource Tarjeta}" Width="380" Padding="36"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Bienvenido" Style="{StaticResource TituloPagina}" />
                    <TextBlock Text="Inicia sesión para ver tu agenda." Style="{StaticResource Subtitulo}" Margin="0,0,0,12" />

                    <TextBlock Text="Usuario" Style="{StaticResource Etiqueta}" />
                    <TextBox x:Name="CajaUsuario" Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Contraseña" Style="{StaticResource Etiqueta}" />
                    <PasswordBox ayuda:PasswordBoxAyuda.Password="{Binding Password, Mode=TwoWay}">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding IniciarSesionCommand}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>

                    <Border Style="{StaticResource CajaError}"
                            Visibility="{Binding Error, Converter={StaticResource TextoAVisibilidad}}">
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" TextWrapping="Wrap" />
                    </Border>

                    <Button Content="Iniciar sesión" Command="{Binding IniciarSesionCommand}" IsDefault="True"
                            Style="{StaticResource BotonPrimario}" Margin="0,24,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
