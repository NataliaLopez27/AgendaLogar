<UserControl x:Class="AgendaLogar.App.Views.PeriodosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AgendaLogar.Presentacion.ViewModels;assembly=AgendaLogar.Presentacion"
             xmlns:c="clr-namespace:AgendaLogar.App.Controles"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance Type=vm:PeriodosViewModel}">
    <Grid Margin="36,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <c:CabeceraPagina Titulo="Periodos" Icono="&#xE787;"
                          Subtitulo="Crea los trimestres y los años, reparte los clientes entre los empleados y cierra los periodos terminados.">
            <c:CabeceraPagina.Acciones>
                <Button Content="+  Nuevo periodo" Command="{Binding AbrirNuevoCommand}" Style="{StaticResource BotonClaro}" />
            </c:CabeceraPagina.Acciones>
        </c:CabeceraPagina>

        <!-- Avisos -->
        <StackPanel Grid.Row="1" Margin="0,10,0,10">
            <Border Style="{StaticResource CajaError}" Visibility="{Binding Error, Converter={StaticResource TextoAVisibilidad}}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource CajaError}" Background="{StaticResource TurquesaClaro}"
                    Visibility="{Binding Aviso, Converter={StaticResource TextoAVisibilidad}}">
                <TextBlock Text="{Binding Aviso}" Foreground="{StaticResource TurquesaOscuro}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Columna izquierda: nuevo periodo y lista ============ -->
            <DockPanel>
                <!-- Nuevo periodo (CU-15 y RF-41) -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Tarjeta}" Padding="20" Margin="0,0,0,16"
                        Visibility="{Binding MostrarNuevo, Converter={StaticResource BoolAVisibilidad}}">
                    <StackPanel>
                        <TextBlock Text="Nuevo periodo" FontFamily="{StaticResource FuenteTitulo}" FontSize="20" Foreground="{StaticResource Negro}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton Content="Trimestral" GroupName="TipoPeriodo" IsChecked="{Binding EsTrimestral, Mode=OneWay}"
                                         FontSize="14" Margin="0,0,18,0" />
                            <RadioButton Content="Anual" GroupName="TipoPeriodo" IsChecked="{Binding NuevoEsAnual}" FontSize="14" />
                        </StackPanel>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Año" Style="{StaticResource Etiqueta}" />
                                <ComboBox ItemsSource="{Binding Anios}" SelectedItem="{Binding NuevoAnio}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding EsTrimestral, Converter={StaticResource BoolAVisibilidad}}">
                                <TextBlock Text="Trimestre" Style="{StaticResource Etiqueta}" />
                                <ComboBox ItemsSource="{Binding Trimestres}" SelectedItem="{Binding NuevoTrimestre}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox IsChecked="{Binding CopiarAnterior}" Margin="0,14,0,0">
                            <TextBlock Text="Copiar las asignaciones del periodo anterior" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock FontSize="12" Foreground="{StaticResource Gris}" TextWrapping="Wrap" Margin="22,2,0,0"
                                   Text="Los clientes que ya no estén vigentes se excluyen y los nuevos quedan sin asignar." />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="Cancelar" Command="{Binding CancelarNuevoCommand}" Style="{StaticResource BotonSecundario}" Margin="0,0,10,0" />
                            <Button Command="{Binding CrearPeriodoCommand}" Style="{StaticResource BotonPrimario}">
                                <TextBlock>
                                    <Run Text="Crear " /><Run Text="{Binding NombreNuevo, Mode=OneWay}" />
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Lista de periodos -->
                <TextBlock DockPanel.Dock="Top" Text="Aún no hay periodos. Pulsa «Nuevo periodo» para crear el primero."
                           Foreground="{StaticResource Gris}" TextWrapping="Wrap" Margin="4,8,0,0"
                           Visibility="{Binding HayPeriodos, Converter={StaticResource BoolAVisibilidad}, ConverterParameter=Invertir}" />
                <ListBox ItemsSource="{Binding Periodos}" SelectedItem="{Binding PeriodoSeleccionado}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Tarjeta" Background="{StaticResource Blanco}" CornerRadius="12" Padding="16,14"
                                                BorderBrush="{StaticResource GrisLinea}" BorderThickness="1" Effect="{StaticResource Sombra}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource Turquesa}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource Turquesa}" />
                                                <Setter TargetName="Tarjeta" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="Tarjeta" Property="Background" Value="{StaticResource TurquesaClaro}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <Border x:Name="Estado" DockPanel.Dock="Right" Style="{StaticResource Pastilla}" Background="#E6F4EC" VerticalAlignment="Center">
                                        <TextBlock x:Name="EstadoTexto" Text="{Binding EstadoTexto}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Exito}" />
                                    </Border>
                                    <TextBlock Text="{Binding Nombre}" FontFamily="{StaticResource FuenteTitulo}" FontSize="20" Foreground="{StaticResource Negro}" />
                                </DockPanel>
                                <ProgressBar Value="{Binding Porcentaje, Mode=OneWay}" Maximum="100" Height="6" Margin="0,10,0,6"
                                             Foreground="{StaticResource Turquesa}" Background="{StaticResource GrisLinea}" BorderThickness="0" />
                                <TextBlock Text="{Binding Progreso}" FontSize="12" Foreground="{StaticResource Gris}" />
                                <TextBlock x:Name="SinAsignar" Text="{Binding SinAsignarTexto}" FontSize="12" Foreground="{StaticResource TurquesaOscuro}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Abierto}" Value="False">
                                    <Setter TargetName="Estado" Property="Background" Value="{StaticResource Fondo}" />
                                    <Setter TargetName="EstadoTexto" Property="Foreground" Value="{StaticResource Gris}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ============ Columna derecha: asignaciones del periodo ============ -->
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="0"
                    Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisibilidad}}">
                <DockPanel>
                    <!-- Cabecera del periodo -->
                    <DockPanel DockPanel.Dock="Top" Margin="22,18,22,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Cerrar periodo" Command="{Binding CerrarPeriodoCommand}" Style="{StaticResource BotonSecundario}"
                                    Visibility="{Binding PeriodoAbierto, Converter={StaticResource BoolAVisibilidad}}" />
                            <Button Content="Reabrir periodo" Command="{Binding ReabrirPeriodoCommand}" Style="{StaticResource BotonSecundario}"
                                    Visibility="{Binding PeriodoCerrado, Converter={StaticResource BoolAVisibilidad}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding PeriodoSeleccionado.Nombre}" FontFamily="{StaticResource FuenteTitulo}" FontSize="26" Foreground="{StaticResource Negro}" />
                            <TextBlock FontSize="13" Foreground="{StaticResource Gris}">
                                <Run Text="{Binding PeriodoSeleccionado.EstadoTexto, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding PeriodoSeleccionado.Progreso, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding PeriodoSeleccionado.SinAsignarTexto, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <!-- Filtros -->
                    <Grid DockPanel.Dock="Top" Margin="22,16,22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="CajaBusqueda" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,10,8" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource FuenteIconos}" Foreground="{StaticResource Gris}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                            <TextBlock Text="Buscar cliente…" Foreground="{StaticResource Gris}" VerticalAlignment="Center"
                                       Margin="36,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=CajaBusqueda}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{x:Static vm:ClientesViewModel.FiltrosTipo}"
                                  DisplayMemberPath="Texto" SelectedItem="{Binding FiltroTipo}" />
                        <ComboBox Grid.Column="2" Margin="10,0,0,0" ItemsSource="{Binding FiltrosEmpleado}"
                                  DisplayMemberPath="Texto" SelectedItem="{Binding FiltroEmpleado}" />
                        <Border Grid.Column="3" Style="{StaticResource Pastilla}" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding RecuentoFilas}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TurquesaOscuro}" />
                        </Border>
                    </Grid>

                    <!-- Barra de asignación (CU-16) -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Fondo}" CornerRadius="0,0,12,12" Padding="22,14">
                        <Grid>
                            <TextBlock Text="Periodo cerrado: reábrelo para cambiar las asignaciones." Foreground="{StaticResource Gris}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding PeriodoCerrado, Converter={StaticResource BoolAVisibilidad}}" />
                            <DockPanel Visibility="{Binding PeriodoAbierto, Converter={StaticResource BoolAVisibilidad}}">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding TextoSeleccion}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TurquesaOscuro}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Asignar a" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Negro}" />
                                    <ComboBox Width="190" ItemsSource="{Binding Empleados}" DisplayMemberPath="Nombre"
                                              SelectedItem="{Binding EmpleadoDestino}" />
                                    <Button Content="Asignar" Command="{Binding AsignarSeleccionadosCommand}" Style="{StaticResource BotonPrimario}" Margin="10,0,0,0" />
                                    <Button Content="Quitar asignación" Command="{Binding QuitarAsignacionCommand}" Style="{StaticResource BotonSecundario}" Margin="10,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Tabla de asignaciones -->
                    <DataGrid ItemsSource="{Binding Filas}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource GrisLinea}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox ToolTip="Seleccionar todos"
                                              IsChecked="{Binding DataContext.TodosSeleccionados, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Seleccionada, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cliente" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Fila.Cliente}" VerticalAlignment="Center" />
                                            <!-- RN-05: último periodo del cliente -->
                                            <Border Style="{StaticResource Pastilla}" Background="{StaticResource ErrorFondo}" Margin="8,0,0,0"
                                                    Visibility="{Binding Fila.EtiquetaBaja, Converter={StaticResource TextoAVisibilidad}}">
                                                <TextBlock Text="{Binding Fila.EtiquetaBaja}" FontSize="11" Foreground="{StaticResource Error}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="NIF" Binding="{Binding Fila.Nif}" Width="100" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Fila.TipoTexto}" Width="115" />
                            <DataGridTextColumn Header="Modelos" Binding="{Binding Fila.Modelos}" Width="150" />
                            <DataGridTemplateColumn Header="Empleado" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Empleado" Text="{Binding Fila.Empleado}" VerticalAlignment="Center" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Fila.SinAsignar}" Value="True">
                                                <Setter TargetName="Empleado" Property="Foreground" Value="{StaticResource Gris}" />
                                                <Setter TargetName="Empleado" Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Fila.EstadoTexto}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
