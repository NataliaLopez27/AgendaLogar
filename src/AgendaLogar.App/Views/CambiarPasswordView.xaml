<UserControl x:Class="AgendaLogar.App.Views.CambiarPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AgendaLogar.Presentacion.ViewModels;assembly=AgendaLogar.Presentacion"
             xmlns:c="clr-namespace:AgendaLogar.App.Controles"
             xmlns:ayuda="clr-namespace:AgendaLogar.App.Comportamientos"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CambiarPasswordViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32" HorizontalAlignment="Center" Width="420">
            <!-- Logo solo en el cambio obligatorio, que se ve sin menú lateral -->
            <c:LogoMonograma Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,16"
                             Visibility="{Binding Obligatorio, Converter={StaticResource BoolAVisibilidad}}" />

            <Border Style="{StaticResource Tarjeta}" Padding="32">
                <StackPanel>
                    <TextBlock Text="Cambiar contraseña" Style="{StaticResource TituloPagina}" FontSize="26" />
                    <TextBlock Text="{Binding Explicacion}" Style="{StaticResource Subtitulo}" Margin="0,0,0,8" />

                    <TextBlock Text="Contraseña actual" Style="{StaticResource Etiqueta}" />
                    <PasswordBox ayuda:PasswordBoxAyuda.Password="{Binding PasswordActual, Mode=TwoWay}" />

                    <TextBlock Text="Contraseña nueva" Style="{StaticResource Etiqueta}" />
                    <PasswordBox ayuda:PasswordBoxAyuda.Password="{Binding PasswordNueva, Mode=TwoWay}" />

                    <TextBlock Text="Repite la contraseña nueva" Style="{StaticResource Etiqueta}" />
                    <PasswordBox ayuda:PasswordBoxAyuda.Password="{Binding PasswordRepetida, Mode=TwoWay}" />

                    <TextBlock Text="{Binding Requisitos}" FontSize="12" Foreground="{StaticResource Gris}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <Border Style="{StaticResource CajaError}"
                            Visibility="{Binding Error, Converter={StaticResource TextoAVisibilidad}}">
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" TextWrapping="Wrap" />
                    </Border>
                    <Border Style="{StaticResource CajaError}" Background="{StaticResource TurquesaClaro}"
                            Visibility="{Binding Exito, Converter={StaticResource TextoAVisibilidad}}">
                        <TextBlock Text="{Binding Exito}" Foreground="{StaticResource TurquesaOscuro}" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource BotonSecundario}"
                                Margin="0,0,10,0"
                                Visibility="{Binding Obligatorio, Converter={StaticResource BoolAVisibilidad}, ConverterParameter=Invertir}" />
                        <Button Content="Guardar" Command="{Binding GuardarCommand}" IsDefault="True" Style="{StaticResource BotonPrimario}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="Cerrar sesión" Command="{Binding CerrarSesionCommand}" Style="{StaticResource BotonEnlace}"
                    HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="{Binding Obligatorio, Converter={StaticResource BoolAVisibilidad}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
