<UserControl x:Class="AgendaLogar.App.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AgendaLogar.Presentacion.ViewModels;assembly=AgendaLogar.Presentacion"
             xmlns:c="clr-namespace:AgendaLogar.App.Controles"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance Type=vm:ClientesViewModel}">
    <Grid Margin="36,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Cabecera -->
        <c:CabeceraPagina Grid.ColumnSpan="2" Titulo="Clientes" Icono="&#xE77B;"
                          Subtitulo="Personas físicas y sociedades a las que la gestoría presenta impuestos.">
            <c:CabeceraPagina.Acciones>
                <Button Content="+  Nuevo cliente" Command="{Binding NuevoCommand}" Style="{StaticResource BotonClaro}" />
            </c:CabeceraPagina.Acciones>
        </c:CabeceraPagina>

        <!-- Filtros y avisos -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Recuento}" Foreground="{StaticResource Gris}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="Mostrar bajas" IsChecked="{Binding MostrarBajas}"
                          VerticalAlignment="Center" Margin="16,0,0,0" />
                <ComboBox DockPanel.Dock="Right" Width="180" ItemsSource="{x:Static vm:ClientesViewModel.FiltrosTipo}" DisplayMemberPath="Texto"
                          SelectedItem="{Binding FiltroSeleccionado}" Margin="12,0,0,0" />
                <!-- Búsqueda con texto de ayuda -->
                <Grid>
                    <TextBox x:Name="CajaBusqueda" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,10,8" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource FuenteIconos}" Foreground="{StaticResource Gris}"
                               VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Buscar por nombre o NIF…" Foreground="{StaticResource Gris}" VerticalAlignment="Center"
                               Margin="36,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CajaBusqueda}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <Border Style="{StaticResource CajaError}"
                    Visibility="{Binding Error, Converter={StaticResource TextoAVisibilidad}}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource CajaError}" Background="{StaticResource TurquesaClaro}"
                    Visibility="{Binding Aviso, Converter={StaticResource TextoAVisibilidad}}">
                <TextBlock Text="{Binding Aviso}" Foreground="{StaticResource TurquesaOscuro}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Listado -->
        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="Tabla" ItemsSource="{Binding Clientes}" SelectedItem="{Binding Seleccionado}" BorderThickness="0">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditarCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre / razón social" Binding="{Binding Nombre}" Width="*" />
                    <DataGridTextColumn Header="NIF" Binding="{Binding Nif}" Width="110" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTexto}" Width="130" />
                    <DataGridTextColumn Header="Modelos" Binding="{Binding Modelos}" Width="200" />
                    <DataGridTemplateColumn Header="Estado" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="Pastilla" Style="{StaticResource Pastilla}" Background="#E6F4EC">
                                    <TextBlock x:Name="Texto" Text="{Binding EstadoTexto}" FontSize="12" Foreground="{StaticResource Exito}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                        <Setter TargetName="Pastilla" Property="Background" Value="{StaticResource Fondo}" />
                                        <Setter TargetName="Texto" Property="Foreground" Value="{StaticResource Gris}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Acciones sobre el seleccionado -->
        <StackPanel x:Name="BarraAcciones" Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Editar" Command="{Binding EditarCommand}" Style="{StaticResource BotonSecundario}" Margin="0,0,10,0" />
            <Button Content="Reactivar" Command="{Binding ReactivarCommand}" Style="{StaticResource BotonSecundario}" Margin="0,0,10,0" />
            <Button Content="Dar de baja" Command="{Binding DarDeBajaCommand}" Style="{StaticResource BotonPeligro}" />
        </StackPanel>

        <!-- Panel lateral -->
        <Border Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" Width="380" Margin="24,0,0,0"
                Style="{StaticResource Tarjeta}" Padding="0" VerticalAlignment="Stretch"
                Visibility="{Binding PanelVisible, Converter={StaticResource BoolAVisibilidad}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="4" CornerRadius="12,12,0,0" Background="{StaticResource Turquesa}" />

                <!-- Botones fijos abajo -->
                <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,20">
                    <Border Style="{StaticResource CajaError}"
                            Visibility="{Binding ErrorPanel, Converter={StaticResource TextoAVisibilidad}}">
                        <TextBlock Text="{Binding ErrorPanel}" Foreground="{StaticResource Error}" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancelar" Command="{Binding CancelarPanelCommand}" Style="{StaticResource BotonSecundario}" Margin="0,0,10,0" />
                        <Button Content="Guardar" Command="{Binding GuardarPanelCommand}" Style="{StaticResource BotonPrimario}" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,8">
                        <TextBlock Text="{Binding TituloPanel}" FontFamily="{StaticResource FuenteTitulo}" FontSize="24" Foreground="{StaticResource Negro}" />

                        <!-- Datos del cliente (alta y edición) -->
                        <StackPanel Visibility="{Binding MostrarFormularioDatos, Converter={StaticResource BoolAVisibilidad}}">
                            <TextBlock Text="Nombre o razón social" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="NIF / CIF" Style="{StaticResource Etiqueta}" />
                                    <TextBox Text="{Binding Nif, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tipo" Style="{StaticResource Etiqueta}" />
                                    <ComboBox ItemsSource="{Binding Tipos}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                                              SelectedValue="{Binding Tipo}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding EsAlta, Converter={StaticResource BoolAVisibilidad}}">
                                <TextBlock Text="Fecha de alta" Style="{StaticResource Etiqueta}" />
                                <DatePicker SelectedDate="{Binding FechaAlta}" FontSize="14" />
                            </StackPanel>

                            <TextBlock Text="Notas" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top" />
                        </StackPanel>

                        <!-- Baja o reactivación (CU-13) -->
                        <StackPanel Visibility="{Binding MostrarBajaReactivacion, Converter={StaticResource BoolAVisibilidad}}">
                            <TextBlock Text="{Binding NombreSeleccionado}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TurquesaOscuro}" Margin="0,6,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="{Binding EtiquetaFecha}" Style="{StaticResource Etiqueta}" />
                            <DatePicker SelectedDate="{Binding FechaOperacion}" FontSize="14" />

                            <Border Background="{StaticResource TurquesaClaro}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource FuenteIconos}"
                                               Foreground="{StaticResource TurquesaOscuro}" Margin="0,2,10,0" />
                                    <TextBlock Text="{Binding Explicacion}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource TurquesaOscuro}" />
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Historial de altas y bajas" Style="{StaticResource Etiqueta}" Margin="0,20,0,6" />
                            <ItemsControl ItemsSource="{Binding Historial}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource Turquesa}"
                                                     VerticalAlignment="Center" Margin="2,0,10,0" />
                                            <TextBlock Text="{Binding Texto}" FontSize="13" Foreground="{StaticResource Negro}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Modelos (solo en el alta) -->
                        <StackPanel Visibility="{Binding EsAlta, Converter={StaticResource BoolAVisibilidad}}">
                            <TextBlock Text="Modelos que lleva" Style="{StaticResource Etiqueta}" Margin="0,18,0,4" />
                            <TextBlock Text="Marca los modelos y su fecha de alta. Solo se muestran los que aplican al tipo de cliente."
                                       FontSize="12" Foreground="{StaticResource Gris}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding ModelosDisponibles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Fila" CornerRadius="8" Padding="10,6" Margin="0,0,0,4" Background="{StaticResource Fondo}">
                                            <DockPanel>
                                                <DatePicker DockPanel.Dock="Right" Width="130" SelectedDate="{Binding FechaAlta}"
                                                            IsEnabled="{Binding Marcado}" />
                                                <CheckBox IsChecked="{Binding Marcado}" VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock>
                                                            <Run Text="{Binding Codigo, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text="{Binding Periodicidad, Mode=OneWay}" Foreground="{StaticResource Gris}" FontSize="11" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Descripcion}" FontSize="11" Foreground="{StaticResource Gris}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Marcado}" Value="True">
                                                <Setter TargetName="Fila" Property="Background" Value="{StaticResource TurquesaClaro}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
